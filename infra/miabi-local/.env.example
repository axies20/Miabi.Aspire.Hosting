# Copy to .env or run scripts/start-miabi-local.ps1, which generates secrets.
MIABI_IMAGE=miabi/miabi:1.6.5
MIABI_EXTERNAL_BASE_DOMAIN=apps.localhost
MIABI_ADMIN_EMAIL=admin@example.com
MIABI_ADMIN_PASSWORD=MiabiLocal2026!
MIABI_DB_PASSWORD=replace-with-random-value
MIABI_REDIS_PASSWORD=replace-with-random-value
MIABI_JWT_SECRET=replace-with-64-hex-characters
MIABI_ENCRYPTION_KEY=replace-with-64-hex-characters
